# Valores locales de ejemplo. Copiar a .env y reemplazar los secretos.
POSTGRES_DB=blacklists
POSTGRES_USER=blacklists
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://blacklists:replace-with-local-password@127.0.0.1:55432/blacklists
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
APP_VERSION=local
# Local: 0. AWS: verificar cantidad real de proxies antes de cambiarlo.
TRUSTED_PROXY_HOPS=0
